# ============================================================
# MAVPose — Environment Variables Template (plot assistant only)
# ============================================================
# Copy this file to .env and fill in your values:
#   cp template.env .env
# MAVPose reads .env from the folder you run `mavpose` in (or a
# parent folder). Installed from PyPI? Just create a .env file there.
#
# !! NEVER commit .env to version control. !!
# !! .env is listed in .gitignore for this reason. !!
# !! This template.env file contains NO real secrets. !!
# ============================================================

# 1. The API key for your provider. Set only the one(s) you use.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# (Local Ollama or LM Studio need no key.)

# 2. The model, as provider:model. Use a model name your provider lists.
#    Providers: openai, anthropic, gemini, openrouter, groq, deepseek,
#    mistral, together, ollama, lmstudio, openai-compatible
MAVPOSE_MODEL=openai:<model-name>
#   MAVPOSE_MODEL=anthropic:<model-name>
#   MAVPOSE_MODEL=ollama:llama3.1:8b
#   With only OPENROUTER_API_KEY set, this line is optional
#   (default z-ai/glm-5.1, or set OPENROUTER_MODEL as in MAVPose 0.2).

# 3. Optional: a different endpoint, e.g. Ollama on another machine,
#    a proxy, or (with openai-compatible) your own server.
# MAVPOSE_BASE_URL=http://gpu-box:11434/v1
# MAVPOSE_API_KEY=
